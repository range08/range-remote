PUBLIC_BASE_URL=https://remote.example.com
DATABASE_PATH=/app/data/range-remote.sqlite
AUTH_ISSUER=https://auth.example.com
AUTH_AUDIENCE=https://remote.example.com
AUTH_JWKS_URL=https://auth.example.com/jwks
AUTH_REQUIRED_SCOPE=remote:use
AGENT_REQUEST_TIMEOUT_MS=30000

MCP_RESOURCE=https://remote.example.com
AUTH_DATABASE_PATH=/app/data/auth.sqlite
AUTH_JWKS_PATH=/app/data/jwks.json
AUTH_COOKIE_KEYS=replace-with-two-long-random-keys-separated-by-a-comma
AUTH_ALLOW_REGISTRATION=false

# Relay resource protection (optional)
MAX_PENDING_AGENT_REQUESTS=256
MAX_PENDING_AGENT_REQUESTS_PER_DEVICE=8
MAX_AGENT_CONNECTIONS=1000
AGENT_WS_MAX_PAYLOAD_BYTES=2097152
AGENT_WS_HEARTBEAT_MS=30000
USER_DEVICE_REQUESTS_PER_MINUTE=300
USER_CONCURRENT_DEVICE_REQUESTS=16
MAX_DEVICES_PER_USER=100
